  "data_field_definitions": {
    "plot_number": "Local plot/house number assigned by municipal authority",
    "locality": "Specific area within Delhi (GK I/II/III or CR Park for MVP)",
    "khasra_number": "Unique land parcel identifier in revenue records",
    "area_sqm": "Total plot area in square meters",
    "owner_name": "Current registered owner (anonymized for privacy)",
    "registration_date": "Date of original property registration",
    "last_transaction_date": "Date of most recent sale/transfer",
    "encumbrance_status": "Legal status: Clear/Mortgaged/Disputed/Unknown",
    "property_type": "Residential/Commercial/Mixed-use",
    "market_value_estimate": "Estimated market value in INR (indicative only)",
    "data_source": "Origin of data: Manual Entry/Public Listing/Crowdsourced/Manual Portal Query",
    "last_verified": "Date when information was last verified"
  },

  "encumbrance_status_definitions": {
    "Clear": "No mortgages, liens, or disputes on record",
    "Mortgaged": "Property has active home loan or mortgage",
    "Disputed": "Legal dispute or court case involving property",
    "Unknown": "Encumbrance status could not be verified"
  },

  "data_source_definitions": {
    "Manual Entry": "Data manually entered by administrator from verified documents",
    "Public Listing": "Information extracted from public real estate listings (99acres, MagicBricks, etc.)",
    "Crowdsourced": "User-contributed data from property owners",
    "Manual Portal Query": "Data obtained through individual queries to official DLRC portal"
  },

