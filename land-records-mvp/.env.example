# Environment variables for Delhi Land Records MVP

# Database path (relative to project root)
DATABASE_PATH=database/land_records.db

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
